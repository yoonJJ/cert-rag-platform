# 운영 배포용 환경변수 템플릿.
# 이 파일을 .env.prod 로 복사하고 값을 채운 뒤 deploy.sh 를 실행하세요.
# deploy.sh 가 이 파일을 서버의 .env 로 전송하면 docker-compose.prod.yml 이 읽습니다.
# (.env.prod / .env 는 절대 git 에 커밋하지 마세요)

# --- DB (운영에서는 반드시 강한 값으로 변경) ---
POSTGRES_DB=certdb
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-strong-password

# --- 외부 공개 웹 포트 (client nginx) ---
WEB_PORT=8080

# --- LLM API 키 ---
# 채팅은 OpenAI / Gemini / Claude 중 선택. 임베딩(RAG)에는 OpenAI 키가 필요합니다.
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# CLAUDE_API_KEY=sk-ant-...

# --- 기본 채팅 모델 (provider/model) ---
CHAT_MODEL=openai/gpt-4o-mini

# --- 임베딩 (DB vector(768) 에 맞춰 768차원) ---
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=768
